# Konfiguration für Rezept Sharing Plattform
# Kopiere diese Datei zu .env und passe die Werte an

# Flask Konfiguration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Sicherheit (in Produktion ändern!)
SECRET_KEY=mein-geheimer-schluessel-fuer-entwicklung

# Datenbank
DATABASE_URL=database.db

# Server Einstellungen
PORT=5000
HOST=127.0.0.1
